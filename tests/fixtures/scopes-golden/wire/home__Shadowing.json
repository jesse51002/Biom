      "html": "<!-- Invented: a section whose markup, slots, plugin node and script each read a different scope. -->\n<style>\n  .layered { display: grid; gap: 1rem; }\n  .layered output { display: block; font-family: monospace; }\n</style>\n<div class=\"layered\" data-who=\"{{who}}\" data-rate=\"{{rate}}\">\n  <h2 title=\"{{only}}\">Layered: {{who}} at {{rate}} {{unit}}, tags {{tags}}, empty [{{empty}}]</h2>\n  <div data-g-part=\"lead\"></div>\n  <div data-g-part=\"plain\"></div>\n  <div data-g-part=\"snippet\"></div>\n  <div data-g-part=\"bare\"></div>\n  <div data-g-part=\"cells\"></div>\n  <div data-g-part=\"plaingrid\"></div>\n  <div data-g-part=\"missing\">A slot the page has not filled.</div>\n  <span data-g-plugin=\"recorder\" data-g-note=\"in the section\"></span>\n  <output class=\"script-scope\"></output>\n</div>\n<script>\n  var out = section.querySelector(\"output.script-scope\");\n  var held = {};\n  Object.keys(ctx.vars).sort().forEach(function (k) { held[k] = ctx.vars[k]; });\n  if (out) out.setAttribute(\"data-scope\", JSON.stringify(held));\n</script>\n",
